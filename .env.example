# ==============================================================================
# TruckerLink API Server - Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
#   cp .env.example .env
# Never commit your real `.env` file — it is git-ignored on purpose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# Port the HTTP/WebSocket server listens on
PORT=3000

# Prefix used for all API routes, e.g. /api/v1
API_VERSION=v1

# ------------------------------------------------------------------------------
# Database (MongoDB)
# ------------------------------------------------------------------------------
# Connection string for your MongoDB instance.
# Local:  mongodb://localhost:27017/truckerlink
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/truckerlink
MONGODB_URI=mongodb://localhost:27017/truckerlink

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
# Secret used to sign JSON Web Tokens.
# Use a long, random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-secret

# Token lifetime (zeit/ms format): 60, "2 days", "10h", "7d", etc.
JWT_EXPIRE=24h

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests.
# These defaults cover the local server and the Expo/Metro dev client.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
# Length of the rate-limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per window per client
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Seed data (used by `npm run seed`)
# ------------------------------------------------------------------------------
# Shared password assigned to every seeded account (users, drivers, mechanics).
# Override to keep local seed credentials out of the default.
SEED_PASSWORD=Password123
